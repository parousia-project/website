---
import { BASE } from "../base";
import { DOCS } from "../docs";
import Page from "./Page.astro";

interface Props {
  frontmatter: { title: string; description: string };
}

const { frontmatter } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, "/");
const position = DOCS.findIndex((doc) => path === `${BASE}docs/${doc.slug}`);
const previous = position > 0 ? DOCS[position - 1] : undefined;
const next = position >= 0 ? DOCS[position + 1] : undefined;
---

<Page title={frontmatter.title} description={frontmatter.description}>
  <div class="wrap docs">
    <nav class="docs-nav" aria-label="Documentation">
      <ul>
        {
          DOCS.map((doc) => (
            <li>
              <a
                href={`${BASE}docs/${doc.slug}`}
                aria-current={path === `${BASE}docs/${doc.slug}` ? "page" : undefined}
              >
                {doc.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <article class="prose">
      <h1>{frontmatter.title}</h1>
      <slot />
      <nav class="pager" aria-label="Previous and next page">
        {
          previous ? (
            <a rel="prev" href={`${BASE}docs/${previous.slug}`}>
              <span>Previous</span>
              {previous.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a rel="next" href={`${BASE}docs/${next.slug}`}>
              <span>Next</span>
              {next.title}
            </a>
          )
        }
      </nav>
    </article>
  </div>
</Page>
