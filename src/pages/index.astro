---
import { BASE } from "../base";
import Page from "../layouts/Page.astro";
import { ACTIVITIES_REPO, CHROME_STORE_URL, FIREFOX_ADDON_URL } from "../site";

const example = `import type { Activity, NativeActivity, Page } from "parousia";

function detect({ url, title }: Page): Activity {
  return {
    id: "example-docs",
    name: "Example Docs",
    details: url.pathname.startsWith("/guide") ? "Reading the guide" : "Browsing the docs",
    state: title.slice(0, 64),
    url: \`\${url.origin}\${url.pathname}\`,
    buttons: [{ label: "Open the docs", url: \`\${url.origin}/\` }],
  };
}

const activity: NativeActivity = { detect };
export default activity;`;

const description =
  "Parousia shows what you are doing in your browser on Discord: an open-source PreMiD alternative with 1,450+ Activities, no server, and no account.";

// Same origin logic as the layout: the Pages workflow passes GitHub's origin as
// --site, which can carry an http scheme.
const origin = Astro.site ? `https://${Astro.site.host}` : "https://parousia.abadima.dev";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${origin}/#website`,
      name: "Parousia",
      url: `${origin}/`,
    },
    {
      "@type": "SoftwareApplication",
      name: "Parousia",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Windows, Linux, Chrome, Firefox",
      description,
      url: `${origin}/`,
      isAccessibleForFree: true,
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      author: {
        "@type": "Organization",
        name: "Parousia Project",
        url: "https://github.com/parousia-project",
      },
    },
  ],
};
---

<Page title="Discord Rich Presence for your browser" description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="wrap hero">
    <h1>Your Rich Presence on Discord and beyond.</h1>
    <p class="lead">
      Parousia shows what you are doing in your browser on Discord. An extension reads the tab, a
      small desktop app passes it to Discord, and there is no server, account, or analytics in
      between. It runs almost all of PreMiD's Activities unchanged, and anyone can write new ones
      in TypeScript.
    </p>
    <div class="actions">
      <a class="button primary" href={CHROME_STORE_URL}>Chrome Web Store</a>
      <a class="button primary" href={FIREFOX_ADDON_URL}>Firefox Add-ons</a>
      <a class="button" href={`${BASE}download/#desktop`}>Get Desktop</a>
    </div>
    <p class="hint">
      Edge and other Chromium browsers use the Chrome Web Store listing. Parousia Desktop is for
      Windows and Linux. Switching from PreMiD, Nowly, or another tool?
      <a href={`${BASE}compare/`}>See the comparison</a>.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="start">
    <h2 id="start">Get started</h2>
    <div class="cards">
      <div class="card">
        <h3>1. Add the extension</h3>
        <p>
          Install Parousia from the <a href={CHROME_STORE_URL}>Chrome Web Store</a> or
          <a href={FIREFOX_ADDON_URL}>Firefox Add-ons</a>. The store keeps it up to date.
        </p>
      </div>
      <div class="card">
        <h3>2. Run Parousia Desktop</h3>
        <p>
          <a href={`${BASE}download/#desktop`}>Download one file</a> for Windows or Linux and open it.
          Discord's desktop app has to be running on the same computer.
        </p>
      </div>
      <div class="card">
        <h3>3. Open a site</h3>
        <p>
          Browse to a supported site. Activities that read only the address and title are on
          already; the rest ask before they read anything.
        </p>
      </div>
    </div>
    <p class="hint">
      First time? <a href={`${BASE}docs/installation/`}>Installation</a> covers the first run,
      including the one-time step Firefox needs.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="pieces">
    <h2 id="pieces">The pieces</h2>
    <div class="cards">
      <div class="card">
        <h3>Browser extension</h3>
        <p>
          Chrome, Edge, and Firefox, plus a userscript. It matches the tab to an Activity and sends
          the result to Desktop. It needs no access to your pages unless you turn on an Activity
          that reads them.
        </p>
      </div>
      <div class="card">
        <h3>Parousia Desktop</h3>
        <p>
          One static program of about a megabyte, for Windows and Linux. It listens on your own
          computer only and hands presence to Discord.
        </p>
      </div>
      <div class="card">
        <h3>Activities</h3>
        <p>
          1,450+ of them: nearly all of PreMiD's, plus Parousia's own. Anyone can add one with a
          pull request.
        </p>
      </div>
      <div class="card">
        <h3>Private by default</h3>
        <p>
          Only what an Activity chooses to show leaves your browser. Sites are read only where you
          allow it, and Desktop refuses extensions it does not recognize.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="developers">
    <h2 id="developers">For developers</h2>
    <div class="split">
      <div>
        <p>
          A native Activity is a folder with a <code>metadata.json</code> and one function. It gets
          the page's URL and title and returns what to show. It cannot run in the page, make
          requests, or store anything, so it needs no extra permission.
        </p>
        <p>
          The Activities repository has the type definitions, a validator, and test helpers, and
          <code>bun run check</code> runs all of them. One environment variable builds your Activity
          into a real extension to try.
        </p>
        <div class="actions">
          <a class="button" href={`${BASE}docs/activities/`}>Write an Activity</a>
          <a class="button" href={ACTIVITIES_REPO}>Activities repository</a>
        </div>
      </div>
      <pre><code>{example}</code></pre>
    </div>
  </section>
</Page>
